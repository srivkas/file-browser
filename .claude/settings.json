{
  "env": {
    "BROWSER": "Safari"
  },
  "permissions": {
    "allow": [
      "Bash(npm run check)",
      "Bash(npm run test)",
      "Bash(npm run lint)",
      "Bash(npm run typecheck)"
    ]
  },
  "enabledPlugins": {
    "file-browser-tools@file-browser": true,
    "file-viewer@file-browser": true
  },
  "extraKnownMarketplaces": {
    "file-browser": {
      "source": {
        "source": "directory",
        "path": "."
      }
    }
  }
}
