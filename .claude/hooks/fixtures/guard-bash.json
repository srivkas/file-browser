[
  { "command": "git push --force", "expect": "block" },
  { "command": "git push -f origin feat/level-6", "expect": "block" },
  { "command": "git push -uf origin feat/level-6", "expect": "block" },
  { "command": "git push origin +main", "expect": "block" },
  { "command": "git -C ../other push --force", "expect": "block" },
  { "command": "npm run check && git push --force origin main", "expect": "block" },
  { "command": "bash -c \"git push --force\"", "expect": "block" },
  { "command": "git push", "expect": "allow" },
  { "command": "git push -u origin feat/level-6", "expect": "allow" },
  { "command": "git push --force-with-lease origin feat/level-6", "expect": "allow" },
  { "command": "git fetch --force", "expect": "allow" },
  { "command": "git commit -m \"Explain why force pushes are blocked\"", "expect": "allow" },
  { "command": "npm run check", "expect": "allow" }
