node_modules
dist
# Secrets never go into git
.env
.env.*
*.log
.DS_Store

# Claude Code personal settings (per machine)
.claude/settings.local.json

# BMAD per-person install answers (name, language) — regenerated by the installer
_bmad/config.user.toml

# Codex copies of the Claude config, regenerated when the project is opened in Codex — this repo is Claude-only
AGENTS.md
.agents/
.codex/

# Claude Code writes these types when it loads a mod
mods/*/.claude-plugin/types/
mods/*/tsconfig.json

# Personal agent audit log written by .claude/hooks/audit-log.mjs
logs/
